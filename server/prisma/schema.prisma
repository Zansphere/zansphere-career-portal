// Zansphere HR Portal — Prisma Schema
// All tables per SRS + Configurable Pipeline

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────

enum UserRole {
  ADMIN
  HR
}

enum CandidateStatus {
  DRAFT
  APPLIED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  SELECTED
  REJECTED
  ACCEPTED
}

enum NoteType {
  INTERVIEW_COMMENT
  HR_COMMENT
}

enum OwnerType {
  CANDIDATE
  EMPLOYEE
}

enum DocType {
  RESUME
  PORTFOLIO
  OFFER_LETTER
  ID_PROOF
  CERTIFICATE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
}

enum NotificationType {
  CANDIDATE_ADDED
  INTERVIEW_SCHEDULED
  EMPLOYEE_ADDED
  STAGE_ADVANCED
  TASK_ASSIGNED
  APPLICATION_REJECTED
  APPLICATION_SELECTED
}

enum ReferenceType {
  CANDIDATE
  EMPLOYEE
  JOB_OPENING
  APPLICATION
}

// ─── Pipeline Enums ──────────────────────────────────

enum StageType {
  APPLICATION
  SCREENING
  TASK
  INTERVIEW
  EVALUATION
  CUSTOM
}

enum JobStatus {
  OPEN
  ON_HOLD
  CLOSED
  FILLED
}

enum ApplicationStatus {
  IN_PIPELINE
  SELECTED
  REJECTED
  WITHDRAWN
  ON_HOLD
}

enum StageProgressStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum StageDecision {
  PENDING
  PASS
  FAIL
  HOLD
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewRecommendation {
  STRONG_YES
  YES
  NEUTRAL
  NO
  STRONG_NO
}

// ─── Users ────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(150)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Login throttling
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz

  // Relations
  candidatesCreated  Candidate[]         @relation("CandidateCreatedBy")
  candidatesUpdated  Candidate[]         @relation("CandidateUpdatedBy")
  employeesCreated   Employee[]          @relation("EmployeeCreatedBy")
  employeesUpdated   Employee[]          @relation("EmployeeUpdatedBy")
  candidateNotes     CandidateNote[]
  candidateTimelines CandidateTimeline[]
  documents          Document[]
  passwordResets     PasswordResetToken[]

  // Pipeline relations
  pipelinesCreated PipelineTemplate[] @relation("PipelineCreatedBy")
  jobsCreated      JobOpening[]       @relation("JobCreatedBy")
  stagesMoved      StageProgress[]    @relation("StageMovedBy")
  tasksEvaluated   TaskAssignment[]   @relation("TaskEvaluator")

  @@index([email])
  @@map("users")
}

// ─── Candidates ───────────────────────────────────────

model Candidate {
  id                 String          @id @default(uuid()) @db.Uuid
  publicToken        String          @unique @map("public_token") @db.VarChar(32)
  name               String          @db.VarChar(150)
  email              String          @db.VarChar(255)
  phone              String          @db.VarChar(20)
  address            String?         @db.VarChar(255)
  city               String?         @db.VarChar(100)
  state              String?         @db.VarChar(100)
  country            String?         @db.VarChar(100)
  positionApplied    String          @map("position_applied") @db.VarChar(150)
  yearsExperience    Decimal?        @map("years_experience") @db.Decimal(4, 1)
  currentCompany     String?         @map("current_company") @db.VarChar(150)
  noticePeriod       String?         @map("notice_period") @db.VarChar(50)
  currentSalary      Decimal?        @map("current_salary") @db.Decimal(12, 2)
  expectedSalary     Decimal?        @map("expected_salary") @db.Decimal(12, 2)
  linkedinUrl        String?         @map("linkedin_url") @db.VarChar(255)
  githubUrl          String?         @map("github_url") @db.VarChar(255)
  portfolioUrl       String?         @map("portfolio_url") @db.VarChar(255)
  personalWebsiteUrl String?         @map("personal_website_url") @db.VarChar(255)
  status             CandidateStatus @default(APPLIED)
  publicLinkEnabled  Boolean         @default(true) @map("public_link_enabled")
  interviewDate      DateTime?       @map("interview_date") @db.Date
  createdById        String?         @map("created_by") @db.Uuid
  updatedById        String?         @map("updated_by") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  createdBy    User?                  @relation("CandidateCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?                  @relation("CandidateUpdatedBy", fields: [updatedById], references: [id])
  skills       CandidateSkillMap[]
  notes        CandidateNote[]
  timeline     CandidateTimeline[]
  documents    Document[]             @relation("CandidateDocuments")
  employee     Employee?
  accessLogs   PublicAccessLog[]
  applications CandidateApplication[]

  @@index([status])
  @@index([positionApplied])
  @@index([createdAt(sort: Desc)])
  @@index([email, positionApplied], map: "idx_candidates_email_position")
  @@map("candidates")
}

// ─── Skills ───────────────────────────────────────────

model Skill {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)

  candidates CandidateSkillMap[]

  @@map("skills")
}

model CandidateSkillMap {
  candidateId String @map("candidate_id") @db.Uuid
  skillId     String @map("skill_id") @db.Uuid

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([candidateId, skillId])
  @@index([skillId])
  @@map("candidate_skill_map")
}

// ─── Candidate Notes ──────────────────────────────────

model CandidateNote {
  id              String   @id @default(uuid()) @db.Uuid
  candidateId     String   @map("candidate_id") @db.Uuid
  noteType        NoteType @map("note_type")
  content         String   @db.Text
  visibleToPublic Boolean  @default(false) @map("visible_to_public")
  createdById     String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id])

  @@index([candidateId])
  @@map("candidate_notes")
}

// ─── Candidate Timeline ──────────────────────────────

model CandidateTimeline {
  id          String   @id @default(uuid()) @db.Uuid
  candidateId String   @map("candidate_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(50)
  description String   @db.VarChar(255)
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id])

  @@index([candidateId])
  @@index([createdAt])
  @@map("candidate_timeline")
}

// ─── Documents (Polymorphic) ─────────────────────────

model Document {
  id         String    @id @default(uuid()) @db.Uuid
  ownerType  OwnerType @map("owner_type")
  ownerId    String    @map("owner_id") @db.Uuid
  docType    DocType   @map("doc_type")
  fileName   String    @map("file_name") @db.VarChar(255)
  s3Key      String    @map("s3_key") @db.VarChar(500)
  mimeType   String    @map("mime_type") @db.VarChar(100)
  sizeBytes  BigInt    @map("size_bytes")
  uploadedById String? @map("uploaded_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  uploadedBy User?     @relation(fields: [uploadedById], references: [id])
  candidate  Candidate? @relation("CandidateDocuments", fields: [ownerId], references: [id], onDelete: Cascade, map: "fk_documents_candidate")

  @@index([ownerType, ownerId], map: "idx_documents_owner")
  @@map("documents")
}

// ─── Departments ─────────────────────────────────────

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  employees   Employee[]
  jobOpenings JobOpening[]

  @@map("departments")
}

// ─── Designations ────────────────────────────────────

model Designation {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  employees   Employee[]
  jobOpenings JobOpening[]

  @@map("designations")
}

// ─── Employees ───────────────────────────────────────

model Employee {
  id                          String           @id @default(uuid()) @db.Uuid
  employeeCode                String           @unique @map("employee_code") @db.VarChar(30)
  candidateId                 String?          @unique @map("candidate_id") @db.Uuid
  fullName                    String           @map("full_name") @db.VarChar(150)
  email                       String           @db.VarChar(255)
  phone                       String?          @db.VarChar(20)
  departmentId                String           @map("department_id") @db.Uuid
  designationId               String           @map("designation_id") @db.Uuid
  managerId                   String?          @map("manager_id") @db.Uuid
  joiningDate                 DateTime         @map("joining_date") @db.Date
  employmentStatus            EmploymentStatus @default(ACTIVE) @map("employment_status")
  emergencyContactName        String?          @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactRelationship String?         @map("emergency_contact_relationship") @db.VarChar(50)
  emergencyContactPhone       String?          @map("emergency_contact_phone") @db.VarChar(20)
  createdById                 String?          @map("created_by") @db.Uuid
  updatedById                 String?          @map("updated_by") @db.Uuid
  createdAt                   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  candidate   Candidate?   @relation(fields: [candidateId], references: [id])
  department  Department   @relation(fields: [departmentId], references: [id])
  designation Designation  @relation(fields: [designationId], references: [id])
  manager     Employee?    @relation("ManagerReports", fields: [managerId], references: [id])
  reports     Employee[]   @relation("ManagerReports")
  createdBy   User?        @relation("EmployeeCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?        @relation("EmployeeUpdatedBy", fields: [updatedById], references: [id])

  // Pipeline relations
  interviews  InterviewRound[] @relation("Interviewer")

  @@index([departmentId])
  @@index([employmentStatus])
  @@index([managerId])
  @@index([email])
  @@map("employees")
}

// ─── Notifications ───────────────────────────────────

model Notification {
  id            String         @id @default(uuid()) @db.Uuid
  type          NotificationType
  message       String         @db.VarChar(255)
  referenceType ReferenceType  @map("reference_type")
  referenceId   String         @map("reference_id") @db.Uuid
  isRead        Boolean        @default(false) @map("is_read")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@index([isRead])
  @@map("notifications")
}

// ─── Public Access Log ───────────────────────────────

model PublicAccessLog {
  id          String   @id @default(uuid()) @db.Uuid
  candidateId String   @map("candidate_id") @db.Uuid
  accessedAt  DateTime @default(now()) @map("accessed_at") @db.Timestamptz
  ipAddress   String?  @map("ip_address") @db.VarChar(45)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("public_access_log")
}

// ─── Password Reset Tokens ──────────────────────────

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// ─── Company Profile (Singleton) ─────────────────────

model CompanyProfile {
  id          String  @id @default(uuid()) @db.Uuid
  companyName String  @map("company_name") @db.VarChar(150)
  logoUrl     String? @map("logo_url") @db.VarChar(500)
  address     String? @db.VarChar(255)

  @@map("company_profile")
}

// ═══════════════════════════════════════════════════════
// ─── CONFIGURABLE RECRUITMENT PIPELINE ───────────────
// ═══════════════════════════════════════════════════════

// ─── Pipeline Templates ──────────────────────────────

model PipelineTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  description String?  @db.Text
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  stages      PipelineStage[]
  jobOpenings JobOpening[]
  createdBy   User?           @relation("PipelineCreatedBy", fields: [createdById], references: [id])

  @@map("pipeline_templates")
}

// ─── Pipeline Stages ─────────────────────────────────

model PipelineStage {
  id            String    @id @default(uuid()) @db.Uuid
  templateId    String    @map("template_id") @db.Uuid
  name          String    @db.VarChar(150)
  stageOrder    Int       @map("stage_order")
  stageType     StageType @map("stage_type")
  isEliminatory Boolean   @default(true) @map("is_eliminatory")
  config        Json?     @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  template       PipelineTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stageProgress  StageProgress[]
  currentForApps CandidateApplication[] @relation("CurrentStage")

  @@unique([templateId, stageOrder])
  @@index([templateId])
  @@map("pipeline_stages")
}

// ─── Job Openings ────────────────────────────────────

model JobOpening {
  id            String    @id @default(uuid()) @db.Uuid
  title         String    @db.VarChar(200)
  departmentId  String    @map("department_id") @db.Uuid
  designationId String?   @map("designation_id") @db.Uuid
  templateId    String    @map("template_id") @db.Uuid
  description   String?   @db.Text
  vacancies     Int       @default(1)
  status        JobStatus @default(OPEN)
  createdById   String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  closedAt      DateTime? @map("closed_at") @db.Timestamptz

  template     PipelineTemplate       @relation(fields: [templateId], references: [id])
  department   Department             @relation(fields: [departmentId], references: [id])
  designation  Designation?           @relation(fields: [designationId], references: [id])
  applications CandidateApplication[]
  createdBy    User?                  @relation("JobCreatedBy", fields: [createdById], references: [id])

  @@index([status])
  @@index([departmentId])
  @@index([createdAt(sort: Desc)])
  @@map("job_openings")
}

// ─── Candidate Applications ──────────────────────────

model CandidateApplication {
  id             String            @id @default(uuid()) @db.Uuid
  candidateId    String            @map("candidate_id") @db.Uuid
  jobOpeningId   String            @map("job_opening_id") @db.Uuid
  currentStageId String?           @map("current_stage_id") @db.Uuid
  status         ApplicationStatus @default(IN_PIPELINE)
  appliedAt      DateTime          @default(now()) @map("applied_at") @db.Timestamptz
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  candidate     Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOpening    JobOpening      @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  currentStage  PipelineStage?  @relation("CurrentStage", fields: [currentStageId], references: [id])
  stageProgress StageProgress[]

  @@unique([candidateId, jobOpeningId])
  @@index([jobOpeningId])
  @@index([status])
  @@map("candidate_applications")
}

// ─── Stage Progress ──────────────────────────────────

model StageProgress {
  id            String              @id @default(uuid()) @db.Uuid
  applicationId String              @map("application_id") @db.Uuid
  stageId       String              @map("stage_id") @db.Uuid
  status        StageProgressStatus @default(PENDING)
  decision      StageDecision       @default(PENDING)
  remarks       String?             @db.Text
  enteredAt     DateTime            @default(now()) @map("entered_at") @db.Timestamptz
  completedAt   DateTime?           @map("completed_at") @db.Timestamptz
  movedById     String?             @map("moved_by") @db.Uuid

  application    CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage          PipelineStage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  movedBy        User?                @relation("StageMovedBy", fields: [movedById], references: [id])
  taskAssignment TaskAssignment?
  interviews     InterviewRound[]

  @@unique([applicationId, stageId])
  @@index([applicationId])
  @@index([stageId])
  @@map("stage_progress")
}

// ─── Task Assignments ────────────────────────────────

model TaskAssignment {
  id               String    @id @default(uuid()) @db.Uuid
  stageProgressId  String    @unique @map("stage_progress_id") @db.Uuid
  title            String    @db.VarChar(200)
  description      String?   @db.Text
  deadline         DateTime? @db.Timestamptz
  submissionUrl    String?   @map("submission_url") @db.Text
  submissionNotes  String?   @map("submission_notes") @db.Text
  submittedAt      DateTime? @map("submitted_at") @db.Timestamptz
  evaluatorId      String?   @map("evaluator_id") @db.Uuid
  evaluatorRemarks String?   @map("evaluator_remarks") @db.Text
  score            Int?
  evaluatedAt      DateTime? @map("evaluated_at") @db.Timestamptz

  stageProgress StageProgress @relation(fields: [stageProgressId], references: [id], onDelete: Cascade)
  evaluator     User?         @relation("TaskEvaluator", fields: [evaluatorId], references: [id])

  @@map("task_assignments")
}

// ─── Interview Rounds ────────────────────────────────

model InterviewRound {
  id              String                   @id @default(uuid()) @db.Uuid
  stageProgressId String                   @map("stage_progress_id") @db.Uuid
  interviewerId   String                   @map("interviewer_id") @db.Uuid
  scheduledAt     DateTime                 @map("scheduled_at") @db.Timestamptz
  durationMinutes Int                      @default(60) @map("duration_minutes")
  meetingLink     String?                  @map("meeting_link") @db.Text
  status          InterviewStatus          @default(SCHEDULED)
  rating          Int?
  remarks         String?                  @db.Text
  recommendation  InterviewRecommendation?
  completedAt     DateTime?                @map("completed_at") @db.Timestamptz

  stageProgress StageProgress @relation(fields: [stageProgressId], references: [id], onDelete: Cascade)
  interviewer   Employee      @relation("Interviewer", fields: [interviewerId], references: [id])

  @@index([stageProgressId])
  @@index([interviewerId])
  @@map("interview_rounds")
}

// ═══ Career Portal Enums ═══════════════════════════════════════

enum PortalUserStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum EmploymentType {
  EMPLOYED
  FRESHER
  STUDENT
  BETWEEN_JOBS
}

enum QualificationLevel {
  TENTH
  TWELFTH
  DIPLOMA
  UG
  PG
}

enum PreferredJobType {
  FULL_TIME
  INTERNSHIP
  CONTRACT
}

enum PreferredWorkMode {
  REMOTE
  HYBRID
  ON_SITE
}

enum PortalApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  INTERVIEW_SCHEDULED
  SELECTED
  REJECTED
  WITHDRAWN
}

// ═══ Portal Users (Candidate Accounts) ═════════════════════════

model PortalUser {
  id           String           @id @default(uuid()) @db.Uuid
  firstName    String           @map("first_name") @db.VarChar(100)
  lastName     String           @map("last_name") @db.VarChar(100)
  email        String           @unique @db.VarChar(255)
  passwordHash String           @map("password_hash") @db.VarChar(255)
  phone        String           @db.VarChar(20)
  status       PortalUserStatus @default(PENDING)
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Login throttling
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz

  // Relations
  otps         Otp[]
  profile      PortalProfile?
  applications PortalJobApplication[]

  @@index([email])
  @@map("portal_users")
}

// ═══ OTP Tokens ════════════════════════════════════════════════

model Otp {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  code      String     @db.VarChar(255) // hashed OTP
  purpose   OtpPurpose
  expiresAt DateTime   @map("expires_at") @db.Timestamptz
  used      Boolean    @default(false)
  attempts  Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("portal_otps")
}

// ═══ Portal Profile (Candidate Base Info) ══════════════════════

model PortalProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  zanpeopleId String? @map("zanpeople_id") @db.Uuid // Links to Zanpeople candidates table

  // Step 1: Personal Details
  fullName        String    @map("full_name") @db.VarChar(200)
  email           String    @db.VarChar(255)
  phone           String    @db.VarChar(20)
  dateOfBirth     DateTime  @map("date_of_birth") @db.Date
  city            String    @db.VarChar(100)
  state           String    @db.VarChar(100)
  willingToRelocate Boolean @default(false) @map("willing_to_relocate")
  preferredCities  String?  @map("preferred_cities") @db.VarChar(500)

  // Step 2: Professional Profile
  employmentStatus  EmploymentType @map("employment_status")
  currentCompany    String         @map("current_company") @db.VarChar(200)
  currentDesignation String       @map("current_designation") @db.VarChar(200)
  totalExperienceYears  Int       @map("total_experience_years")
  totalExperienceMonths Int       @map("total_experience_months")
  relevantExperienceYears  Int    @map("relevant_experience_years")
  relevantExperienceMonths Int    @map("relevant_experience_months")
  currentCtcFixed   Decimal?      @map("current_ctc_fixed") @db.Decimal(12, 2)
  currentCtcVariable Decimal?     @map("current_ctc_variable") @db.Decimal(12, 2)
  expectedCtc       Decimal?      @map("expected_ctc") @db.Decimal(12, 2)
  noticePeriod      String        @map("notice_period") @db.VarChar(50)

  // Step 3: Education is now in PortalEducationHistory

  // Step 4: Skills (stored as JSON for flexibility)
  skills Json? @db.JsonB

  // Step 5: Job Preferences
  preferredJobType    PreferredJobType  @map("preferred_job_type")
  preferredWorkMode   PreferredWorkMode @map("preferred_work_mode")
  preferredDepartment String            @map("preferred_department") @db.VarChar(100)
  roleOfInterest      String?           @map("role_of_interest") @db.VarChar(100)
  subscribeJobAlerts  Boolean           @default(true) @map("subscribe_job_alerts")

  // Step 6: Documents & Links
  resumeUrl     String?  @map("resume_url") @db.Text
  resumeFileName String? @map("resume_file_name") @db.VarChar(255)
  portfolioUrl  String?  @map("portfolio_url") @db.Text
  linkedinUrl   String?  @map("linkedin_url") @db.VarChar(500)
  githubUrl     String?  @map("github_url") @db.VarChar(500)
  otherLinks    Json?    @map("other_links") @db.JsonB
  panNumber     String?  @map("pan_number") @db.VarChar(10)

  // Step 7: Consent
  dpdpConsent   Boolean  @default(false) @map("dpdp_consent")
  consentTimestamp DateTime? @map("consent_timestamp") @db.Timestamptz
  consentIp     String?  @map("consent_ip") @db.VarChar(45)
  termsVersionId String? @default("v1.0") @map("terms_version_id") @db.VarChar(50)

  // Metadata
  currentStep   Int      @default(1) @map("current_step")
  isComplete    Boolean  @default(false) @map("is_complete")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user              PortalUser              @relation(fields: [userId], references: [id], onDelete: Cascade)
  employmentHistory EmploymentHistoryEntry[]
  educationHistory  PortalEducationHistory[]

  @@map("portal_profiles")
}

// ═══ Job Applications (Link Profile to Jobs) ═══════════════════

model PortalJobApplication {
  id             String            @id @default(uuid()) @db.Uuid
  shortId        String            @unique @map("short_id") @db.VarChar(12)
  userId         String            @map("user_id") @db.Uuid
  jobId          String?           @map("job_id") @db.Uuid // Null if general application
  jobTitle       String            @map("job_title") @db.VarChar(200) // snapshot
  candidateId    String            @map("candidate_id") @db.Uuid // Links to Zanpeople candidates table
  status         PortalApplicationStatus @default(SUBMITTED)
  appliedAt      DateTime          @default(now()) @map("applied_at") @db.Timestamptz

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("portal_job_applications")
}

// ═══ Employment & Education History ════════════════════════════

model EmploymentHistoryEntry {
  id            String @id @default(uuid()) @db.Uuid
  profileId     String @map("profile_id") @db.Uuid
  company       String @db.VarChar(200)
  role          String @db.VarChar(200)
  durationFrom  String @map("duration_from") @db.VarChar(20) 
  durationTo    String @map("duration_to") @db.VarChar(20)   
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  profile PortalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("portal_employment_history")
}

model PortalEducationHistory {
  id                   String @id @default(uuid()) @db.Uuid
  profileId            String @map("profile_id") @db.Uuid
  institution          String @db.VarChar(300)
  degreeSpecialization String @map("degree_specialization") @db.VarChar(300)
  yearOfPassing        Int    @map("year_of_passing")
  percentageOrCgpa     String @map("percentage_or_cgpa") @db.VarChar(20)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  profile PortalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("portal_education_history")
}
